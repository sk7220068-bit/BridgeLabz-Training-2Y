import java.util.Random;
import java.util.Scanner;

public class NumberGuessingGame {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        playGame(scanner);
        scanner.close();
    }

    public static void playGame(Scanner scanner) {
        Random random = new Random();
        int lowerBound = 1;
        int upperBound = 100;
        int guesses = 0;
        boolean guessedCorrectly = false;

        System.out.println("Think of a number between 1 and 100.");
        System.out.println("I will try to guess it. Tell me if my guess is 'high', 'low', or 'correct'.");

        while (!guessedCorrectly) {
            int guess = generateGuess(lowerBound, upperBound, random);
            guesses++;
            System.out.println("My guess is: " + guess);

            String feedback = getUserFeedback(scanner);

            switch (feedback.toLowerCase()) {
                case "high":
                    upperBound = guess - 1;
                    break;
                case "low":
                    lowerBound = guess + 1;
                    break;
                case "correct":
                    guessedCorrectly = true;
                    System.out.println("Yay! I guessed your number " + guess + " in " + guesses + " guesses.");
                    break;
                default:
                    System.out.println("Invalid feedback. Please enter 'high', 'low', or 'correct'.");
                    break;
            }

            if (lowerBound > upperBound) {
                System.out.println("Something went wrong. It seems you might have given inconsistent feedback.");
                break;
            }
        }
    }

    public static int generateGuess(int lowerBound, int upperBound, Random random) {
        return random.nextInt(upperBound - lowerBound + 1) + lowerBound;
    }

    public static String getUserFeedback(Scanner scanner) {
        System.out.print("Is my guess (high/low/correct)? ");
        return scanner.next();
    }
}
